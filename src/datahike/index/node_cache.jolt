(ns datahike.index.node-cache
  "jolt stand-in for the Caffeine node cache: least recently used nodes evicted until the
   weighed bytes are under max-bytes. Each node is weighed by an estimate of what its keys
   retain on Chez (node-bytes), not counted at a fixed size: a decoded node held about 12.4 KB,
   so the former count of max-bytes / 4096 nodes let the cache hold three times its budget.
   Recency is a second chance (a clock): a hit sets the entry's flag and nothing else, so a hit
   allocates nothing (a branch keeps no child it restored, so every step of a seek is a hit:
   a persistent-map update on each cost a seek 1.8x); the queue is a sorted map from a tick to
   the address, and an eviction takes the oldest, moving it to the newest end once if it was hit
   since.
   A large value (a string or byte array) a node's Datom holds is one object every node that
   read it holds (a value stored out of line is read once by its key, and :eavt and :aevt, and
   :avet, hold that object): it is weighed once, while any cached node holds it, not once in each
   (a root's leaves weighed 112 MB and retained 69 MB counted by node)."
  (:require [datahike.datom]))

(def ^:private entry-bytes 200)


(defn- value-weight
  "Bytes a string (4 a character: Chez strings are UTF-32) or a byte array retains."
  [v]
  (if (string? v) (+ 16 (* 4 (count v))) (+ 16 (alength ^bytes v))))

(defn- value-bytes
  "Bytes a key's value retains on Chez: a string is 4 bytes a character (Chez strings are
   UTF-32) and a header; a Datom is an 80-byte record; a symbol read from the store is a
   record of its own with its name's text (Jolt does not intern symbols); keywords are
   interned and shared. Calibrated against a once-counted walk of a root's cache, where
   Datoms weighed at 48 and symbols at 0 left the leaves 1.26x over their weight."
  [v]
  (cond
    (nil? v) 0
    (or (string? v) (bytes? v)) (value-weight v)
    (keyword? v) 0
    (symbol? v) (+ 64 (* 4 (+ (count (name v)) (count (or (namespace v) "")))))
    (boolean? v) 0
    (number? v) 16
    (instance? datahike.datom.Datom v) (+ 80 (value-bytes (:v v)))
    (vector? v) (+ 32 (* 8 (count v)) (reduce + 0 (map value-bytes v)))
    (map? v) (reduce-kv (fn [n k x] (+ n 32 (value-bytes k) (value-bytes x))) 64 v)
    (coll? v) (+ 32 (* 16 (count v)) (reduce + 0 (map value-bytes v)))
    :else 64))

(def ^:private shared-min
  "Characters or bytes from which a Datom's value is weighed once for all the nodes holding it."
  256)

(defn- shared-value
  "The value of Datom d when it is large (a string or byte array), else nil."
  [d]
  (when (instance? datahike.datom.Datom d)
    (let [v (:v d)]
      (when (or (and (string? v) (>= (count v) shared-min)) (and (bytes? v) (>= (alength ^bytes v) shared-min)))
        v))))

(defn- node-keys [node] (when-not (or (vector? node) (map? node) (string? node) (nil? node)) (.keys node)))

(defn- shared-values
  "The large values node's keys hold, one per key."
  [node]
  (into [] (keep shared-value) (node-keys node)))

(defn node-bytes
  "Estimated bytes a cached entry retains: for an index node, an entry, its key array and what
   its keys retain, and for a branch each child's address (a uuid) and slot, without following
   children into other nodes; for anything else the cache holds (an out-of-line value's
   [generation value-key] under its datom, persistent-set's in-line), an entry and what the
   value retains. A large value is counted whole, as if no other node held it (the cache
   counts it once)."
  [node]
  (if-let [ks (node-keys node)]
    (+ entry-bytes 64 (* 8 (count ks)) (reduce + 0 (map value-bytes ks))
       (if (pos? (.level node)) (* 72 (count ks)) 0))
    (+ entry-bytes (value-bytes node))))

(defn- own-bytes
  "node-bytes without its large values vs, which the cache counts once across nodes."
  [node vs]
  (- (node-bytes node) (reduce + 0 (map value-weight vs))))

(defrecord NodeCache [state max-bytes hits misses evictions])

(defn cache? [value] (instance? NodeCache value))

(defn create [max-bytes]
  (->NodeCache (atom {:nodes {} :order (sorted-map) :tick 0 :total 0 :shared {}})
               max-bytes (atom 0) (atom 0) (atom 0)))

(defn- slot
  "Index of the pair holding v itself in bucket, or nil."
  [bucket v]
  (loop [i 0]
    (when (< i (count bucket))
      (if (identical? v (first (nth bucket i))) i (recur (inc i))))))

(defn- share
  "State s with large value v held by one more node: its weight joins the total when no
   other held it. :shared maps a value's identity hash to the [value holders] pairs of that hash."
  [s v]
  (let [h (System/identityHashCode v) bucket (get (:shared s) h [])]
    (if-let [i (slot bucket v)]
      (assoc-in s [:shared h] (update-in bucket [i 1] inc))
      (-> s (assoc-in [:shared h] (conj bucket [v 1])) (update :total + (value-weight v))))))

(defn- unshare
  "State s with large value v held by one node fewer: its weight leaves the total with the last."
  [s v]
  (let [h (System/identityHashCode v) bucket (get (:shared s) h) i (slot bucket v)
        n (second (nth bucket i))]
    (if (> n 1)
      (assoc-in s [:shared h] (update-in bucket [i 1] dec))
      (let [bucket' (into (subvec bucket 0 i) (subvec bucket (inc i)))]
        (-> s (update :total - (value-weight v))
            (assoc :shared (if (empty? bucket') (dissoc (:shared s) h) (assoc (:shared s) h bucket'))))))))

(defn- requeue
  "State s with address a moved to the newest end of the order, its hit flag cleared."
  [s a]
  (let [[node t w hit vs] (get (:nodes s) a) t' (inc (:tick s))]
    (vreset! hit false)
    (-> s (assoc :tick t') (update :order dissoc t) (update :order assoc t' a)
        (assoc-in [:nodes a] [node t' w hit vs]))))

(defn- drop-entry [s a]
  (if-let [[_ t w _ vs] (get (:nodes s) a)]
    (reduce unshare
            (-> s (update :nodes dissoc a) (update :order dissoc t) (update :total - w))
            vs)
    s))

(defn- shrink
  "State s with its oldest entries evicted until its total is within max-bytes: [s' evicted].
   An oldest entry hit since it was queued goes to the newest end instead, once."
  [s max-bytes]
  (loop [s s n 0]
    (if (and (> (:total s) max-bytes) (seq (:order s)))
      (let [a (val (first (:order s)))]
        (if @(nth (get (:nodes s) a) 3)
          (recur (requeue s a) n)
          (recur (drop-entry s a) (inc n))))
      [s n])))

(defn lookup [cache address]
  (if-let [[node _ _ hit] (get (:nodes @(:state cache)) address)]
    (do (swap! (:hits cache) inc) (vreset! hit true) node)
    (do (swap! (:misses cache) inc) nil)))

(defn put!
  "Hold node at address, weighed by node-bytes (its large values once across the nodes
   holding them); a node heavier than the whole budget is not held (as Caffeine refuses one)."
  [cache address node]
  (let [max-bytes (:max-bytes cache)]
    (when (<= (node-bytes node) max-bytes)
      (let [n (volatile! 0) vs (shared-values node) w (own-bytes node vs)]
        (swap! (:state cache)
               (fn [s] (let [s (drop-entry s address) t (inc (:tick s))
                             s (-> s (assoc :tick t) (assoc-in [:nodes address] [node t w (volatile! false) vs])
                                   (update :order assoc t address) (update :total + w))
                             s (reduce share s vs)
                             [s e] (shrink s max-bytes)]
                         (vreset! n e) s)))
        (swap! (:evictions cache) + @n))))
  nil)

(defn evict! [cache address] (swap! (:state cache) drop-entry address) nil)

(defn stats [cache]
  (let [s @(:state cache)]
    {:nodes (count (:nodes s)) :max-bytes (:max-bytes cache) :weighted-bytes (:total s)
     :hits @(:hits cache) :misses @(:misses cache) :evictions @(:evictions cache)}))
