(ns ^:no-doc datahike.index.persistent-set
  "jolt stand-in for the persistent-sorted-set index (EXPERIMENT, not the PSS B-tree).
   Each index is jolt's built-in PersistentTreeSet (sorted-set-by) wrapped in a
   deftype implementing IIndex. Slices seek with a probe record so the
   nil-wildcard slice comparator is consulted only against the bounds.
   No node storage: an index is stored as one value (its datom vector) under one
   konserve key at flush; restore rebuilds the tree."
  (:require [datahike.datom :as dd :refer [index-type->cmp-quick]]
            [datahike.index.audit :as audit :refer [IAuditable]]
            [datahike.index.interface :as di :refer [IIndex]]
            [hasch.core :refer [squuid]]
            [konserve.core :as k]))

(def index-type->kwseq
  {:eavt [:e :a :v :tx :added]
   :aevt [:a :e :v :tx :added]
   :avet [:a :v :e :tx :added]})

;; The slice comparator: a component nil in a bound is a wildcard (compares equal).
(defn- slice-cmp [index-type from to]
  (let [kws (index-type->kwseq index-type)]
    (fn [d bound]
      (loop [ks kws]
        (if-let [k (first ks)]
          (if (nil? (get bound k))
            (recur (next ks))
            (let [c ((dd/cmp-val k) d bound)]
              (if (zero? c) (recur (next ks)) c)))
          0)))))

(defrecord Probe [d c])

(defn- probe-cmp [base]
  (fn [a b]
    (cond (instance? Probe a) (- ((:c a) b (:d a)))
          (instance? Probe b) ((:c b) a (:d b))
          :else (base a b))))

(declare ->PSet)

;; The two PSS methods the query executor's JVM paths call by interop.
(definterface ICursorSource
  (lookupGE [key])
  (forwardCursor [])
  (forwardCursor [cmp]))

(definterface IForwardCursor
  (seekGE [key])
  (next []))

(deftype Cursor [tree cmp ^:unsynchronized-mutable s]
  IForwardCursor
  (seekGE [_ key]
    (set! s (seq (subseq tree >= (->Probe key (fn [x k] (cmp x k))))))
    (first s))
  (next [_]
    (set! s (next s))
    (first s)))

(deftype PSet [tree index-type address storage _meta]
  ICursorSource
  (lookupGE [_ key] (first (subseq tree >= key)))
  (forwardCursor [_] (Cursor. tree (index-type->cmp-quick index-type false) nil))
  (forwardCursor [_ cmp] (Cursor. tree (fn [x k] (.compare cmp x k)) nil))
  clojure.lang.Seqable
  (seq [_] (seq tree))
  clojure.lang.Counted
  (count [_] (count tree))
  clojure.lang.IMeta
  (meta [_] _meta)
  clojure.lang.IObj
  (withMeta [_ m] (PSet. tree index-type address storage m)))

(defn- with-tree [^PSet p tree]
  (PSet. tree (.-index-type p) nil (.-storage p) (.-_meta p)))

(defn- empty-tree [index-type]
  (sorted-set-by (probe-cmp (index-type->cmp-quick index-type false))))

(defn- lookup* [^PSet p key cmp]
  ;; `cmp` orders by a prefix of the set's order: the first element at or after
  ;; the probe is the only candidate.
  (let [b (first (subseq (.-tree p) >= (->Probe key cmp)))]
    (when (and b (zero? (cmp b key))) b)))

(defn- slice* [^PSet p from to index-type]
  (let [c (slice-cmp index-type from to)]
    (seq (subseq (.-tree p) >= (->Probe from c) <= (->Probe to c)))))

(defn- rslice* [^PSet p from to index-type]
  (let [c (slice-cmp index-type from to)]
    (seq (rsubseq (.-tree p) >= (->Probe to c) <= (->Probe from c)))))

(defn insert [^PSet p datom index-type]
  (if (lookup* p datom (dd/index-type->cmp-prefix index-type))
    p
    (with-tree p (conj (.-tree p) datom))))

(defn upsert [^PSet p datom index-type old-datom]
  (with-tree p (cond-> (.-tree p) old-datom (disj old-datom) true (conj datom))))

(defn temporal-upsert [^PSet p datom index-type old-datom]
  (let [{:keys [e a v tx added]} datom
        old-val (:v old-datom)]
    (if (and (some? old-datom) (or (not added) (not= v old-val)))
      (with-tree p (-> (.-tree p) (conj old-datom) (conj (dd/datom e a old-val tx false))))
      p)))

(defn- store-key [address] [:jolt-index address])

(extend-type PSet
  IIndex
  (-slice [p from to index-type] (slice* p from to index-type))
  (-rslice [p from to index-type] (rslice* p from to index-type))
  (-lookup [p key cmp] (lookup* p key cmp))
  (-count-slice [p from to cmp] (count (seq (subseq (.-tree p) >= (->Probe from cmp) <= (->Probe to cmp)))))
  (-has-subtree-counts? [_] false)
  (-all [p] (seq p))
  (-seq [p] (seq p))
  (-count [p] (count p))
  (-insert [p datom index-type _] (insert p datom index-type))
  (-temporal-insert [p datom _ _] (with-tree p (conj (.-tree p) datom)))
  (-upsert [p datom index-type _ old] (upsert p datom index-type old))
  (-temporal-upsert [p datom index-type _ old] (temporal-upsert p datom index-type old))
  (-remove [p datom _ _] (with-tree p (disj (.-tree p) datom)))
  (-flush [p _]
    (if (.-address p)
      p
      (let [address (squuid)]
        (when-let [pw (some-> (.-storage p) :pending-writes)]
          (swap! pw conj [(store-key address) (vec (.-tree p))]))
        (PSet. (.-tree p) (.-index-type p) address (.-storage p) (.-_meta p)))))
  (-transient [p] p)
  (-persistent! [p] p)
  (-mark ([p] (if (.-address p) #{(store-key (.-address p))} #{}))
         ([p seen] (let [a (store-key (.-address p))]
                     (if (contains? @seen a) #{} (do (swap! seen conj a) #{a})))))
  (-root-node [_] nil)
  (-seed-root! [p _] p))

(extend-type PSet
  IAuditable
  (-merkle-root [p] (.-address p))
  (-recompute-merkle-root [p] (.-address p)))

(defn diff [a b index-type from to]
  (let [sa (set (di/-slice a from to index-type)) sb (set (di/-slice b from to index-type))]
    [(vec (remove sb (di/-slice a from to index-type)))
     (vec (remove sa (di/-slice b from to index-type)))]))

(defrecord CachedStorage [store config pending-writes])

(defn create-storage [store config]
  (->CachedStorage store config (atom [])))

(defmethod di/empty-index :datahike.index/persistent-set [_ store index-type _]
  (->PSet (empty-tree index-type) index-type nil (:storage store) {:index-type index-type}))

(defmethod di/init-index :datahike.index/persistent-set [_ store datoms index-type _ {:keys [indexed]}]
  (let [ds (if (= index-type :avet) (filter #(contains? indexed (:a %)) datoms) datoms)]
    (->PSet (into (empty-tree index-type) ds) index-type nil (:storage store) {:index-type index-type})))

;; EDN (StringSerializer) form of a flushed index: its address and type only.
;; The tag has no dot in its namespace: Jolt's clojure.edn reads #a.b/T as a
;; record-constructor form and never consults :readers (Jolt v0.8.23).
;; the datoms live under (store-key address) and with-storage reloads them.
(defmethod print-method PSet [^PSet p ^java.io.Writer w]
  (.write w (str "#datahike/PSet " (pr-str {:address (.-address p) :index-type (.-index-type p)}))))

(defn- pset-from-reader [{:keys [address index-type]}]
  (PSet. nil index-type address nil {:index-type index-type}))

(defmethod di/add-konserve-handlers :datahike.index/persistent-set [config store]
  (when-let [rh (:read-handlers store)]
    (when (instance? clojure.lang.IAtom rh)
      (swap! rh assoc
             'datahike/PSet pset-from-reader
             'datahike/Datom dd/datom-from-reader)))
  (let [storage (or (:storage store) (create-storage store config))]
    (when-let [sa (:storage-atom store)] (reset! sa storage))
    (assoc store :storage storage :datahike/store-id (or (get-in config [:store :id]) (:id config)))))

(defmethod di/with-storage :datahike.index/persistent-set [_ pset storage]
  (if (instance? PSet pset)
    (let [^PSet p pset
          tree (or (.-tree p)
                   (into (empty-tree (.-index-type p))
                         (k/get (:store storage) (store-key (.-address p)) nil {:sync? true})))]
      (PSet. tree (.-index-type p) (.-address p) storage (.-_meta p)))
    pset))

(defmethod di/konserve-backend :datahike.index/persistent-set [_ store] store)

(defmethod di/default-index-config :datahike.index/persistent-set [_] {})
