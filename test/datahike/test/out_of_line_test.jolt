(ns datahike.test.out-of-line-test
  "On Jolt, with `:index-config {:value-out-of-line-bytes n}`, a written node holds each value
  of n bytes or more (`value-bytes`: a string's characters, a byte array's length, a
  collection's elements and one byte each, any other value 8) as a ref to its own key. The
  node's other values cost the check alone: no walk."
  (:require [clojure.test :refer [deftest is testing]]
            [datahike.api :as d]
            [datahike.datom :as dd]
            [datahike.connections :as connections]
            [datahike.index.interface :as di]
            [konserve.store] [konserve.jolt.store] [konserve.jolt.lmdb])
  (:import [org.replikativ.persistent_sorted_set Leaf Settings]))

;; a path prefix of this run's own: parallel runs must not delete-database each other's stores
(def ^:private run-dir (str (System/getProperty "java.io.tmpdir") "/dh-out-of-line-" (random-uuid)))

(def ^:private out-of-line #'datahike.index.persistent-set/out-of-line)
(def ^:private value-bytes #'datahike.index.persistent-set/value-bytes)

(defn- leaf [values]
  (let [ds (map-indexed (fn [i v] (dd/datom (inc i) :v v 536870913)) values)]
    (Leaf. (count ds) (object-array ds) (Settings. 128 nil 0 :weak))))

(defn- stored-out
  "The indexes of values the stored node holds out of line, and the calls of value-bytes it took."
  [store limit values]
  (let [calls (atom 0)
        vb @value-bytes
        node (with-redefs [datahike.index.persistent-set/value-bytes (fn [v l] (swap! calls inc) (vb v l))]
               (out-of-line nil store (di/make-node-cache {:store-cache-size 16}) (atom []) limit (leaf values)))
        ks (.-_keys node)]
    [(set (keep (fn [i] (when-not (identical? (nth values i) (.-v (aget ks i))) i)) (range (count values))))
     @calls]))

(defn- vb-of [v limit] (@value-bytes v limit))

(defn- s [n] (apply str (repeat n "x")))

(deftest a-node-holds-out-of-line-exactly-its-values-of-limit-bytes-or-more
  (let [cfg {:store {:backend :lmdb :path (str run-dir "-bound") :default-serializer :FaslSerializer
                     :id #uuid "9c000000-0000-0000-0000-0000000001b0"}
             :keep-history? true :schema-flexibility :read}
        _ (d/delete-database cfg)
        _ (d/create-database cfg)
        conn (d/connect cfg)
        store (:store @conn)]
    (try
      (doseq [limit [1000 8]]
        (testing (str "at a limit of " limit)
          (let [values [(s (dec limit)) (s limit) (byte-array (dec limit)) (byte-array limit)
                        [(s (- limit 2))] [(s (dec limit))] {:k (s (- limit 12))} {:k (s (- limit 11))}
                        [[(s (- limit 3))]] [[(s (- limit 4))]] 5 :keyword-of-a-long-name 2.5 true]
                expected (set (keep-indexed (fn [i v] (when (>= (vb-of v limit) limit) i)) values))]
            (is (= expected (first (stored-out store limit values))) "as value-bytes counts them")
            (is (seq expected)))))
      (testing "the values that cannot reach the limit cost no walk"
        (is (= [#{} 0] (stored-out store 1000 [(s 10) 5 :k 2.5 true (s 999) (byte-array 3)]))))
      (finally
        (d/release conn)
        (d/delete-database cfg)))))

(deftest a-seek-fetches-only-the-values-it-returns
  ;; a cold leaf whose neighbours hold large out-of-line values: a seek of one small attribute
  ;; fetches none of them, and the large value it does return is the value written
  (let [cfg {:store {:backend :lmdb :path (str run-dir "-lazy") :default-serializer :FaslSerializer
                     :id #uuid "9c000000-0000-0000-0000-0000000001b1"}
             :keep-history? true :schema-flexibility :read
             :index-config {:value-out-of-line-bytes 1024}}
        big (fn [i] (str i "-" (s 4000)))
        _ (d/delete-database cfg)
        _ (d/create-database cfg)
        conn (d/connect cfg)
        _ (d/transact conn (vec (for [i (range 40)] {:db/id (- -1 i) :small i :big (big i)})))
        e (:e (first (filter #(= 7 (:v %)) (d/datoms @conn :aevt :small))))
        _ (d/release conn)
        conn (d/connect cfg)
        fetches (atom 0)
        get0 konserve.core/get]
    (try
      (with-redefs [konserve.core/get (fn [& args] (let [r (apply get0 args)] (when (string? r) (swap! fetches inc)) r))]
        (testing "a small attribute's seek fetches no large value"
          (is (= [7] (mapv :v (d/datoms @conn :eavt e :small))))
          (is (= 0 @fetches)))
        (testing "the large value it returns is the value written, fetched once"
          (is (= (big 7) (:v (first (d/datoms @conn :eavt e :big)))))
          (is (= 1 @fetches))
          (is (= (big 7) (:v (first (d/datoms @conn :eavt e :big)))))
          (is (= 1 @fetches))))
      (testing "a commit that rewrites the leaf keeps every value, unread ones included"
        (d/transact conn [{:db/id e :small 700}])
        (d/release conn)
        (let [conn (d/connect cfg)]
          (is (= (set (map big (range 40))) (set (map :v (d/datoms @conn :aevt :big)))))
          (is (= (big 7) (:big (d/pull @conn [:big] e))))
          (d/release conn)))
      (finally
        (d/delete-database cfg)))))

(deftest an-unread-value-is-read-through-the-reading-processs-store
  ;; a node holding an unread value is valid in any process: a fork (simulated, as connections-fork-test does)
  ;; that adopts the node cache reads the value through its own connect, never its parent's handle
  (let [cfg {:store {:backend :lmdb :path (str run-dir "-fork") :default-serializer :FaslSerializer
                     :id #uuid "9c000000-0000-0000-0000-0000000001b2"}
             :keep-history? true :schema-flexibility :read
             :index-config {:value-out-of-line-bytes 1024}}
        big (fn [i] (str i "-" (s 4000)))
        _ (d/delete-database cfg)
        _ (d/create-database cfg)
        conn (d/connect cfg)
        _ (d/transact conn (vec (for [i (range 40)] {:db/id (- -1 i) :small i :big (big i)})))
        _ (d/release conn)
        conn (d/connect cfg)
        db @conn
        e (:e (first (filter #(= 7 (:v %)) (d/datoms db :aevt :small))))]
    (try
      ;; the leaf is cached, its large values unread
      (is (= [7] (mapv :v (d/datoms db :eavt e :small))))
      (connections/after-fork!)
      (testing "after the fork, nothing reads a value through the parent's store"
        (is (= :value-store-not-open
               (try (:v (first (d/datoms db :eavt e :big))) nil
                    (catch Exception x (:type (ex-data x)))))))
      (testing "the fork's own connect reads it, from the node cache it adopted"
        (let [child (d/connect cfg)]
          (is (= (big 7) (:v (first (d/datoms @child :eavt e :big)))))
          (d/release child)))
      (finally
        (d/delete-database cfg)))))

(deftest a-cached-leaf-never-outgrows-its-weight
  ;; the node cache books an entry's weight once, at put!; a read of a leaf's large values must not grow the leaf after that,
  ;; or the bound counts less than the cache holds (a standing agent's leaves booked 112.7 MB weighed 155.6 MB after reads,
  ;; 2026-11-16): a large value read is held by the cache under its own weighed entry, never written into the leaf
  (let [cfg {:store {:backend :lmdb :path (str run-dir "-weight") :default-serializer :FaslSerializer
                     :id #uuid "9c000000-0000-0000-0000-0000000001b3"}
             ;; the byte-bounded node cache, as Seon configures it (without it the cache is a count-bounded LRU)
             :store-cache-bytes 100000000
             :keep-history? true :schema-flexibility :read
             :index-config {:value-out-of-line-bytes 1024}}
        big (fn [i] (str i "-" (s 4000)))
        _ (d/delete-database cfg)
        _ (d/create-database cfg)
        conn (d/connect cfg)
        _ (d/transact conn (vec (for [i (range 40)] {:db/id (- -1 i) :small i :big (big i)})))
        _ (d/release conn)
        conn (d/connect cfg)]
    (try
      (is (= (set (map big (range 40))) (set (map :v (d/datoms @conn :aevt :big)))) "every large value reads back")
      ;; this store's cache: the registry also holds what earlier tests left (an inherited entry is another store's)
      (let [cache (some (fn [[k v]] (when (and (vector? k) (= (get-in cfg [:store :id]) (first k))) (:node-cache v)))
                        @connections/*connections*)
            st @(:state cache)
            now (reduce + 0 (map (fn [[n]] (datahike.index.node-cache/node-bytes n)) (vals (:nodes st))))]
        (is (= (:total st) now) "the booked total is what the cached entries weigh now"))
      (finally
        (d/release conn)
        (d/delete-database cfg)))))
