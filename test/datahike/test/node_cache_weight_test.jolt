(ns datahike.test.node-cache-weight-test
  "The jolt node cache holds nodes by their weighed bytes, not a fixed 4096 a node."
  (:require [clojure.test :refer [deftest is]]
            [datahike.index.interface :as index]
            [datahike.index.node-cache :as nodes]
            [datahike.datom :as datom]
            [datahike.api :as d]
            [datahike.connections :as connections]
            [jolt.scheme :as scm])
  (:import [org.replikativ.persistent_sorted_set Leaf Branch Settings]))

(defn- leaf [datoms] (Leaf. (count datoms) (object-array datoms) (Settings. 128 nil 0 :weak)))

(deftest a-node-weighs-what-its-keys-retain
  (let [small (leaf [(datom/datom 1 :value "s" 1)])
        big (leaf (mapv #(datom/datom % :value (apply str (repeat 1000 "x")) 1) (range 10)))]
    (is (< (nodes/node-bytes small) 1000))
    (is (< 40000 (nodes/node-bytes big)) "ten 1,000-character strings at 4 bytes a character")))

(def ^:private retained
  ;; Chez's own count of the bytes x reaches (compute-size), the shared parts included
  (do (scm/eval-string "(define (dh-retained x) (compute-size x))")
      (fn [x] (scm/call "dh-retained" x))))

(deftest a-node-weighs-what-it-retains
  ;; a leaf as a store reads one: 64 datoms, a third with a symbol value (a ref by name, as
  ;; :form/refs carries), the rest strings and numbers. What its 61 datoms past the first three
  ;; add is weighed within a tenth of what they add retained (the three hold what every leaf
  ;; shares: the record types, the settings); Datoms at 48 bytes and symbols at 0 weighed it at
  ;; about 0.6
  (let [ds (mapv (fn [i] (datom/datom i :value (case (mod i 3)
                                                     0 (symbol (str "seon.demo" (mod i 7)) (str "a-name-" i))
                                                     1 (str "text of datom " i " in its leaf")
                                                     2 (* 1000 i))
                                      536870913))
                 (range 64))
        node (leaf ds) base (leaf (subvec ds 0 3))
        real (- (retained node) (retained base))
        w (- (nodes/node-bytes node) (nodes/node-bytes base))]
    (is (< (* 0.9 real) w (* 1.1 real)) (str "weighed " w ", retains " real))))

(deftest the-cache-stays-within-its-bytes-and-evicts-the-oldest
  (let [cache (index/make-node-cache {:store-cache-bytes 100000})
        node (leaf (mapv #(datom/datom % :value (apply str (repeat 1000 "x")) 1) (range 5)))
        w (nodes/node-bytes node)]
    (doseq [k (range 10)] (index/cache-put! cache k node))
    (let [held (filter #(index/cache-get cache %) (range 10))]
      (is (<= (:weighted-bytes (index/node-cache-stats cache)) 100000))
      (is (= (quot 100000 w) (count held)) "as many as the bytes allow, not 100000 / 4096")
      (is (= (range (- 10 (count held)) 10) held) "the newest are the ones held"))))

(deftest an-oversize-node-is-refused
  (let [cache (index/make-node-cache {:store-cache-bytes 10000})
        large (leaf [(datom/datom 2 :value (apply str (repeat 100000 "x")) 1)])]
    (index/cache-put! cache :large large)
    (is (nil? (index/cache-get cache :large)))
    (is (zero? (:weighted-bytes (index/node-cache-stats cache))))))

(deftest a-hit-keeps-a-node-from-eviction
  (let [cache (index/make-node-cache {:store-cache-bytes 100000})
        node (leaf (mapv #(datom/datom % :value (apply str (repeat 1000 "x")) 1) (range 5)))
        cap (quot 100000 (nodes/node-bytes node))]
    (doseq [k (range cap)] (index/cache-put! cache k node))
    (index/cache-get cache 0)
    (index/cache-put! cache :new node)
    (is (some? (index/cache-get cache 0)) "0 was touched, so 1 went first")
    (is (nil? (index/cache-get cache 1)))))

(deftest an-in-line-value-is-weighed-by-what-it-retains
  ;; persistent-set's in-line caches an out-of-line value's [generation value-key] under its
  ;; datom, which is no index node: it is weighed as a value, and held
  (let [cache (index/make-node-cache {:store-cache-bytes 1000000})
        v [3 #uuid "00000000-0000-0000-0000-000000000001"]]
    (index/cache-put! cache :d v)
    (is (= v (index/cache-get cache :d)))
    (is (< 0 (nodes/node-bytes v) 1000))))

(deftest a-cache-weighs-what-the-nodes-it-holds-retain
  ;; a store read through a cache a third of its size: reading the indexes evicts nodes, and the
  ;; cache's weighed total is within a tenth of what the nodes it still holds retain (Chez's
  ;; compute-size of them), the shared parts counted once. Branches that held the children they
  ;; restored kept the evicted nodes alive, so the weight was 0.7 of what was retained and fell
  ;; as the cache turned over (a root's cache: 125.7 MB weighed, 204-226 MB retained)
  (let [id (random-uuid)
        path (str (System/getProperty "java.io.tmpdir") "/node-cache-weigh-" id)
        cfg {:store {:backend :file :path path :id id} :store-cache-bytes 400000 :index-config {:branching-factor 64}
             :schema-flexibility :read :keep-history? false}
        text (fn [i] (str "form " i " " (apply str (repeat 40 (str "w" (mod i 97) " ")))))]
    (d/create-database cfg)
    (let [c (d/connect cfg)]
      (doseq [part (partition-all 500 (range 6000))]
        (d/transact c (mapv (fn [i] {:db/id (- (inc i)) :n i :text (text i) :ref (symbol "seon.demo" (str "v" (mod i 50)))}) part)))
      (d/release c))
    (let [c (d/connect cfg)
          entry (some (fn [[_ e]] (when (:node-cache e) e)) @connections/*connections*)
          cache (:node-cache entry)]
      (doseq [idx [:eavt :aevt]] (is (pos? (count (d/datoms @c idx)))))
      (doseq [i (range 0 6000 7)] (is (seq (d/datoms @c :eavt (inc i)))))
      (let [held (mapv first (vals (:nodes @(:state cache))))
            stats (index/node-cache-stats cache)
            ;; what the process keeps of the store: the cache's nodes and the roots the db value
            ;; holds (a root is no cache entry), every node they reach counted once
            roots (remove (fn [r] (some #(identical? r %) held)) (map #(.root %) [(:eavt @c) (:aevt @c)]))
            ;; the first leaf and the first branch bring in what every node shares (their record
            ;; types and code), which is no node's own: left out of both sides
            base (vec (concat (take 1 (filter #(instance? Leaf %) held)) (take 1 (filter #(instance? Branch %) held))))
            weighed (- (+ (:weighted-bytes stats) (reduce + (map nodes/node-bytes roots))) (reduce + (map nodes/node-bytes base)))
            real (- (retained (into held roots)) (retained base))]
        (is (pos? (:evictions stats)) "the cache turned over, or this proves nothing")
        (is (< 10 (count held)) "it holds more than a few nodes")
        (is (< (* 0.9 real) weighed (* 1.1 real)) (str "weighed " weighed ", retains " real)))
      (d/release c))
    (d/delete-database cfg)))
